{
  "expo": {
    "name": "Community Response Hub",
    "slug": "community-response-hub",
    "version": "1.0.1",
    "description": "Report, track, and resolve community complaints",
    "scheme": "community-response-hub",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "web": {
      "name": "Community Response Hub",
      "shortName": "CRH"
    },
    "android": {
      "package": "com.angelaracheldev.communityresponsehub",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6366F1"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.angelaracheldev.communityresponsehub",
      "buildNumber": "1"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EEF2FF"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false
          },
          "ios": {
            "newArchEnabled": false
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Community Response Hub to access your photos for complaint evidence.",
          "cameraPermission": "Allow Community Response Hub to use the camera for complaint evidence."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "extra": {
      "router": {
        "disableSynchronousScreensUpdates": true
      },
      "eas": {
        "projectId": "87dccfd8-b5df-4ff5-a58b-02338df4387c"
      }
    }
  }
}
